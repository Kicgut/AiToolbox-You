clash_api:
  base_url: "127.0.0.1:9090"
  secret: ""
server:
  listen_port: 8899
storage:
  db_path: "./features/proxy-traffic-monitor/data/traffic.db"
  retention_days: 30
collector:
  minute_flush_interval_sec: 60
  connlog_flush_interval_sec: 10
  cleanup_interval_hours: 24
  ws_reconnect_backoff_sec: [1, 2, 5, 10, 30]
