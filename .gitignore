# Python caches and local environments
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/venv/
**/.venv/
**/node_modules/
**/.vite/

# Repository-local disposable artifacts. Only the policy file is tracked.
.artifacts/*
!.artifacts/README.md

# Local runtime data and machine-specific configuration
/data/
features/proxy-traffic-monitor/data/
features/proxy-traffic-monitor/config.yaml
.claude/settings.local.json
.impeccable/

# Secrets and local environment files
.env
.env.*
!.env.example

# Logs, temporary files, and operating-system metadata
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store

# Legacy root-level test/verification names are forbidden; ignore defensively.
/.pytest-*/
/pytest-*/
/codex-test-*/
/verification-temp*/
/phase*-temp*/
/.tmp-smoke*.db
